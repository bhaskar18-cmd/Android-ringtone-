<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#0B111A</item>
        <item name="colorPrimaryDark">#0B111A</item>
        <item name="colorAccent">#22D3EE</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#0B111A</item>
        <item name="android:windowBackground">#0B111A</item>
        <item name="android:statusBarColor">#0B111A</item>
        <item name="android:navigationBarColor">#0B111A</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">#0B111A</item>
        <item name="android:statusBarColor">#0B111A</item>
        <item name="android:navigationBarColor">#0B111A</item>
    </style>
</resources>